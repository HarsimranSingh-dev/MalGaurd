# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=MalGuard
APP_VERSION=1.0.0
DEBUG=false

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./database/malguard.db

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── ML model paths ────────────────────────────────────────────────────────────
ML_MODEL_PATH=ml_models/artifacts/classifier.joblib
SCALER_PATH=ml_models/artifacts/scaler.joblib
LABEL_ENCODER_PATH=ml_models/artifacts/label_encoder.joblib
